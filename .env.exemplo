# Copie este arquivo para .env (na pasta api/) e troque os valores.
# O .env está no .gitignore: segredos nunca vão para o GitHub.

# Banco PostgreSQL
OASIS_DATABASE_URL=postgresql+psycopg://oasis:TROQUE_A_SENHA@localhost:5432/oasis

# Chave das ações exclusivas do posto (aprovar pontos, cadastrar estação, leitura por HTTP).
# Gere uma: python -c "import secrets; print(secrets.token_urlsafe(24))"
OASIS_CHAVE_POSTO=troque-esta-chave-do-posto

# MQTT: a estação ESP32 (Wokwi) publica no broker público e a API assina o tópico.
OASIS_MQTT_HABILITADO=true
OASIS_MQTT_HOST=broker.hivemq.com
OASIS_MQTT_PORTA=1883
OASIS_MQTT_PREFIXO=oasis-rm560760
# A MESMA chave fica no sketch do ESP32 (iot/sketch.ino, constante CHAVE_HMAC).
OASIS_MQTT_HMAC_CHAVE=oasis-demo-2026-troque-esta-chave

# Documentação interativa em /docs (pode desligar em produção)
OASIS_DOCS_HABILITADA=true

# Opcionais
# OASIS_LOG_ARQUIVO=C:\oasis\logs\api.log
# OASIS_MODELO_DIR=C:\oasis\ml\modelo

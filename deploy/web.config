<?xml version="1.0" encoding="utf-8"?>
<!--
  Hospedagem da API Oásis no IIS (Windows Server) com o HttpPlatformHandler.
  O IIS recebe as requisições na porta 80 e repassa para o processo Python (uvicorn),
  que ele mesmo inicia, monitora e reinicia se cair.

  Estrutura no servidor (ver o repositório oasis-operating-systems):
    C:\oasis\site\web.config        este arquivo (pasta física do site no IIS)
    C:\oasis\api\                   código da API + .venv
    C:\oasis\ml\modelo\             modelo de IA
    C:\oasis\config\oasis.env       segredos (NTFS: só OasisPool e Administradores)
    C:\oasis\logs\                  logs da API e do uvicorn
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="OasisPython" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="C:\oasis\api\.venv\Scripts\python.exe"
                  arguments="-m uvicorn oasis_api.main:criar_app --factory --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --app-dir C:\oasis\api --no-server-header --proxy-headers --forwarded-allow-ips 127.0.0.1"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\oasis\logs\uvicorn"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  rapidFailsPerMinute="10"
                  processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="OASIS_ENV_FILE" value="C:\oasis\config\oasis.env" />
        <environmentVariable name="OASIS_LOG_ARQUIVO" value="C:\oasis\logs\api.log" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <!-- Não anuncia "Microsoft-IIS/10.0" nas respostas -->
      <requestFiltering removeServerHeader="true" />
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
